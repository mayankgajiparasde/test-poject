# Copy to .env (git-ignored) and fill in your own values. Neither has a default.

# PostgreSQL password. Letters and digits only (it goes into a connection string), for example: openssl rand -hex 24
HUE_DB_PASSWORD=

# Signing key of the local development tokens, at least 32 bytes, for example: openssl rand -hex 32
HUE_JWT_KEY=

# Port of the API on 127.0.0.1 (default 5080).
#HUE_API_PORT=5080
