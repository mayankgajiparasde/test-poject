<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotelUnderwriting.Application\HotelUnderwriting.Application.csproj" />
    <ProjectReference Include="..\HotelUnderwriting.Core\HotelUnderwriting.Core.csproj" />
    <ProjectReference Include="..\HotelUnderwriting.Excel\HotelUnderwriting.Excel.csproj" />
    <ProjectReference Include="..\HotelUnderwriting.Persistence\HotelUnderwriting.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HotelUnderwriting.Persistence.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="openapi.v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="golden-base.json" LogicalName="golden-base.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
  </ItemGroup>

</Project>
